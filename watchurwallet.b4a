@EndOfDesignText@
#Region  Project Attributes
	#ApplicationLabel: WatchYourWallet
	#VersionCode: 1
	#VersionName:
	'SupportedOrientations possible values: unspecified, landscape or portrait.
	#SupportedOrientations: unspecified
	#CanInstallToExternalStorage: False
#End Region

#Region  Activity Attributes
	#FullScreen: False
	#IncludeTitle: False
#End Region

Sub Process_Globals
	Public sql As SQL
	Public usernamee As String
	Public fname As String
	Public lname As String
	Public email As String
	Public role As String
End Sub

Sub Globals
	Private txtUsername As EditText
	Private txtPassword As EditText
	Private btnLogin As Button
	Private btnSignup As Button
End Sub

Sub Activity_Create(FirstTime As Boolean)
	If FirstTime Then
		CopyDB
		sql.Initialize(File.DirInternal, "saddbb.db", False)
		EnsureSchema
	End If
	BuildLoginFromScratch
End Sub

Sub BuildLoginFromScratch
	Activity.RemoveAllViews
	Activity.Color = Colors.White

	Dim w As Int = 100%x
	Dim h As Int = 100%y
	Dim pad As Int = 24dip
	Dim spacing As Int = 12dip
	Dim labelH As Int = 22dip
	Dim ctrlH As Int = 48dip
	Dim btnH As Int = 50dip
	Dim contentW As Int = w - pad * 2
	Dim primary As Int = Colors.RGB(0, 150, 136)
	Dim cardBG As Int = Colors.RGB(235, 245, 245)

	Dim cardW As Int = MinInt(contentW, 360dip)
	Dim cardX As Int = (w - cardW) / 2

	Dim totalH As Int = 80dip + (labelH + 6dip + ctrlH + spacing) * 2 + btnH + spacing + btnH
	Dim y As Int = (h - totalH) / 2
	If y < pad Then y = pad

	AddBrandTitle("WatchYourWallet", cardX, y, cardW, primary)
	y = y + 60dip + spacing

	AddHeaderLabel("Username", cardX, y, cardW, primary)
	y = y + labelH + 6dip
	txtUsername.Initialize("txtUsername")
	StyleInputEditText(txtUsername, "Enter your username", cardBG)
	Activity.AddView(txtUsername, cardX, y, cardW, ctrlH)
	y = y + ctrlH + spacing

	AddHeaderLabel("Password", cardX, y, cardW, primary)
	y = y + labelH + 6dip
	txtPassword.Initialize("txtPassword")
	StyleInputEditText(txtPassword, "Enter your password", cardBG)
	txtPassword.PasswordMode = True
	Activity.AddView(txtPassword, cardX, y, cardW, ctrlH)
	y = y + ctrlH + spacing * 2

	btnLogin.Initialize("btnLogin")
	StyleButton(btnLogin, "Login", primary)
	Activity.AddView(btnLogin, cardX, y, cardW, btnH)
	y = y + btnH + spacing

	btnSignup.Initialize("btnSignup")
	StyleButton(btnSignup, "Sign Up", Colors.Black)
	Activity.AddView(btnSignup, cardX, y, cardW, btnH)
End Sub

Sub MinInt(a As Int, b As Int) As Int
	If a < b Then Return a
	Return b
End Sub

Sub TagGlobals
	txtUsername.Tag = "g"
	txtPassword.Tag = "g"
	btnLogin.Tag = "g"
	btnSignup.Tag = "g"
End Sub

Sub HideExtras
	For i = 0 To Activity.NumberOfViews - 1
		Dim v As View = Activity.GetView(i)
		Dim t As String = "" & v.Tag
		If t <> "g" Then v.Visible = False
	Next
End Sub

Sub HoistTaggedToActivity
	For i = 0 To Activity.NumberOfViews - 1
		Dim v As View = Activity.GetView(i)
		Dim vt As String = "" & v.Tag
		If v Is Panel And vt <> "g" Then
			Dim p As Panel = v
			For j = p.NumberOfViews - 1 To 0 Step -1
				Dim child As View = p.GetView(j)
				Dim ct As String = "" & child.Tag
				If ct = "g" Then
					Dim cx As Int = child.Left + p.Left
					Dim cy As Int = child.Top + p.Top
					Dim cw As Int = child.Width
					Dim ch As Int = child.Height
					child.RemoveView
					Activity.AddView(child, cx, cy, cw, ch)
				End If
			Next
		End If
	Next
End Sub

Sub AddBrandTitle(text As String, x As Int, y As Int, w As Int, color As Int)
	Dim lbl As Label
	lbl.Initialize("")
	lbl.Text = text
	lbl.TextSize = 26
	lbl.TextColor = color
	lbl.Typeface = Typeface.DEFAULT_BOLD
	lbl.Gravity = Gravity.CENTER
	Activity.AddView(lbl, x, y, w, 50dip)
End Sub

Sub AddHeaderLabel(text As String, x As Int, y As Int, w As Int, color As Int)
	Dim lbl As Label
	lbl.Initialize("")
	lbl.Text = text
	lbl.TextSize = 14
	lbl.TextColor = color
	lbl.Typeface = Typeface.DEFAULT_BOLD
	Activity.AddView(lbl, x, y, w, 22dip)
End Sub

Sub StyleInputEditText(et As EditText, hint As String, bg As Int)
	et.Hint = hint
	et.TextSize = 15
	et.TextColor = Colors.Black
	Dim cd As ColorDrawable
	cd.Initialize2(bg, 10dip, 1dip, Colors.LightGray)
	et.Background = cd
	et.SingleLine = True
	et.Padding = Array As Int(14dip, 0, 14dip, 0)
End Sub

Sub StyleButton(btn As Button, text As String, color As Int)
	btn.Text = text
	btn.TextColor = Colors.White
	btn.TextSize = 16
	Dim cd As ColorDrawable
	cd.Initialize2(color, 12dip, 0, color)
	btn.Background = cd
End Sub

Sub Activity_Resume
	txtUsername.Text = ""
	txtPassword.Text = ""
	txtUsername.RequestFocus
End Sub

Private Sub btnLogin_Click
	If txtUsername.Text = "" Or txtPassword.Text = "" Then
		ToastMessageShow("Enter username and password", False)
		Return
	End If

	Dim rs As ResultSet
	rs = sql.ExecQuery2("SELECT * FROM tblusers WHERE username=? AND password=?", Array As String(txtUsername.Text, txtPassword.Text))

	If rs.NextRow Then
		role = rs.GetString("role")
		usernamee = rs.GetString("username")
		fname = rs.GetString("fname")
		lname = rs.GetString("lname")
		email = rs.GetString("email")
		rs.Close
		If role = "admin" Then
			StartActivity(admin)
		Else
			StartActivity(dashboard)
		End If
	Else
		rs.Close
		ToastMessageShow("Invalid Login", False)
	End If
End Sub

Private Sub btnSignup_Click
	StartActivity(signup)
End Sub

Sub CopyDB()
	If File.Exists(File.DirInternal, "saddbb.db") = False Then
		File.Copy(File.DirAssets, "saddbb.db", File.DirInternal, "saddbb.db")
	End If
End Sub

' Ensures schema is up to date on existing installs.
Sub EnsureSchema
	sql.ExecNonQuery("CREATE TABLE IF NOT EXISTS tblusers (username TEXT PRIMARY KEY, password TEXT, role TEXT, fname TEXT, lname TEXT, email TEXT UNIQUE)")
	sql.ExecNonQuery("CREATE TABLE IF NOT EXISTS tblallowance (money_id INTEGER PRIMARY KEY AUTOINCREMENT, amount REAL, date TEXT, username TEXT)")
	sql.ExecNonQuery("CREATE TABLE IF NOT EXISTS tbltransac (transac_id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT, amount REAL, date TEXT, username TEXT)")
	sql.ExecNonQuery("CREATE TABLE IF NOT EXISTS tblgoal (goal_id INTEGER PRIMARY KEY AUTOINCREMENT, category TEXT, goal_amount REAL, current_amount REAL, username TEXT)")
	sql.ExecNonQuery("CREATE TABLE IF NOT EXISTS tblexpenses (expense_id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT, category TEXT, amount REAL, date TEXT)")
	sql.ExecNonQuery("CREATE TABLE IF NOT EXISTS tblsplit (split_id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT, category TEXT, persons INTEGER, bill REAL, share REAL, date TEXT)")

	AddColumnIfMissing("tblallowance", "username", "TEXT")
	AddColumnIfMissing("tblallowance", "amount", "REAL")
	AddColumnIfMissing("tblallowance", "date", "TEXT")

	AddColumnIfMissing("tbltransac", "username", "TEXT")
	AddColumnIfMissing("tbltransac", "type", "TEXT")
	AddColumnIfMissing("tbltransac", "amount", "REAL")
	AddColumnIfMissing("tbltransac", "date", "TEXT")

	AddColumnIfMissing("tblgoal", "username", "TEXT")
	AddColumnIfMissing("tblgoal", "category", "TEXT")
	AddColumnIfMissing("tblgoal", "goal_amount", "REAL")
	AddColumnIfMissing("tblgoal", "current_amount", "REAL DEFAULT 0")

	AddColumnIfMissing("tblexpenses", "username", "TEXT")
	AddColumnIfMissing("tblexpenses", "category", "TEXT")
	AddColumnIfMissing("tblexpenses", "amount", "REAL")
	AddColumnIfMissing("tblexpenses", "date", "TEXT")

	AddColumnIfMissing("tblsplit", "username", "TEXT")
	AddColumnIfMissing("tblsplit", "category", "TEXT")
	AddColumnIfMissing("tblsplit", "persons", "INTEGER")
	AddColumnIfMissing("tblsplit", "bill", "REAL")
	AddColumnIfMissing("tblsplit", "share", "REAL")
	AddColumnIfMissing("tblsplit", "date", "TEXT")
End Sub

Sub AddColumnIfMissing(table As String, col As String, decl As String)
	Dim rs As ResultSet
	Dim exists As Boolean = False
	rs = sql.ExecQuery("PRAGMA table_info(" & table & ")")
	Do While rs.NextRow
		If rs.GetString("name") = col Then
			exists = True
			Exit
		End If
	Loop
	rs.Close
	If exists = False Then
		Try
			sql.ExecNonQuery("ALTER TABLE " & table & " ADD COLUMN " & col & " " & decl)
		Catch
			Log("AddColumn failed: " & LastException.Message)
		End Try
	End If
End Sub
